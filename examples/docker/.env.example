# Optional Docker Compose overrides for examples/docker/docker-compose.yml.
# Copy to .env in this directory before running docker compose if you want to
# customize host ports or common node settings.

HUB_HTTP_PORT=8081
SF_HTTP_PORT=8082
NY_HTTP_PORT=8083
CHICAGO_HTTP_PORT=8084

HUB_PEER_PORT=9100
SF_PEER_PORT=9101
NY_PEER_PORT=9102
CHICAGO_PEER_PORT=9103

EVENTMESH_LOG_LEVEL=info
EVENTMESH_EVENTLOG_BACKEND=memory
# EVENTMESH_EVENTLOG_BACKEND=pebble
# EVENTMESH_EVENTLOG_PATH=/var/lib/eventmesh/eventlog
